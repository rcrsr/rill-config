# Build output
dist/
*.tsbuildinfo

# Compiled TypeScript artifacts in src/ (build outputs to dist/)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map

# Dependencies
node_modules/
!tests/fixtures/**/node_modules/

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Misc
*.tgz
.npm

# Test runtime artifacts
**/test-data-integration/

# Internal files
.claude/
.codanna/
.fastembed_cache
conduct
internal/
.serena/

# Scratch directories the ecosystem toolchain writes. Part of the shared
# baseline (STD-DOC-5) rather than of this package: kept in step with rill's
# .gitignore so a tool that starts writing one here does not get committed.
.fresh/
.rill-tmp/
