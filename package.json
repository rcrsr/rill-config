{
  "name": "@rcrsr/rill-config",
  "version": "0.21.0",
  "description": "Shared config library for rill resolution, validation, loading, and bindings generation",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "keywords": [
    "rill",
    "config",
    "scripting",
    "extensions",
    "project-loader"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install --force",
    "bootstrap": "bash scripts/bootstrap.sh",
    "build": "tsc --build",
    "build:dev": "tsc --build tsconfig.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "rill-test-rules",
    "check": "pnpm run check:format && pnpm run check:lint && pnpm run check:types && pnpm run build && pnpm run test && pnpm run test:rules && pnpm run check:deps && pnpm run check:standards",
    "check:types": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:lint": "oxlint --type-aware --config .oxlintrc.json src/ tests/",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "check:standards": "rill-check-standards",
    "fix:lint": "oxlint --type-aware --config .oxlintrc.json --fix src/ tests/",
    "fix:format": "oxfmt"
  },
  "dependencies": {
    "semver": "^7.8.6"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.23.0"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.23.0",
    "@rcrsr/rill-dev": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-config.git"
  },
  "homepage": "https://github.com/rcrsr/rill-config",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-config/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
